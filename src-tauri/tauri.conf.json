{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Repert2r",
  "version": "1.0.0",
  "identifier": "com.repert2r.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Repert2r",
        "width": 1080,
        "height": 640,
        "minWidth": 760,
        "minHeight": 460,
        "backgroundColor": "#0e0e10",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["resources/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
